<Window x:Class="GoodNotesClone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoodNotesClone.Views"
        xmlns:converters="clr-namespace:GoodNotesClone.Converters"
        mc:Ignorable="d"
        Title="GoodNotes Clone" Height="700" Width="1000" WindowState="Maximized">
    
    <Window.Resources>
        <converters:ToolTypeToPenCheckedConverter x:Key="ToolTypeToPenCheckedConverter"/>
        <converters:ToolTypeToHighlighterCheckedConverter x:Key="ToolTypeToHighlighterCheckedConverter"/>
        <converters:ToolTypeToEraserCheckedConverter x:Key="ToolTypeToEraserCheckedConverter"/>
        <converters:ToolTypeToLassoCheckedConverter x:Key="ToolTypeToLassoCheckedConverter"/>
        <converters:ToolTypeToHandCheckedConverter x:Key="ToolTypeToHandCheckedConverter"/>
    </Window.Resources>
    
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- File Menu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="New" ToolTip="New Notebook (Ctrl+N)" Command="{Binding NewNotebookCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}"/>
                    <Button Content="Open" ToolTip="Open Notebook (Ctrl+O)" Command="{Binding OpenNotebookCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}"/>
                    <Button Content="Save" ToolTip="Save Notebook (Ctrl+S)" Command="{Binding SaveNotebookCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}"/>
                </StackPanel>
                
                <!-- Tools -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="Pen" ToolTip="Pen (P)" Command="{Binding SelectPenCommand}" 
                            Margin="2" Padding="8,4" 
                            Style="{StaticResource ToolButtonStyle}" 
                            IsChecked="{Binding CurrentTool.Type, Converter={StaticResource ToolTypeToPenCheckedConverter}}"/>
                    <Button Content="Highlighter" ToolTip="Highlighter (H)" Command="{Binding SelectHighlighterCommand}" 
                            Margin="2" Padding="8,4" 
                            Style="{StaticResource ToolButtonStyle}" 
                            IsChecked="{Binding CurrentTool.Type, Converter={StaticResource ToolTypeToHighlighterCheckedConverter}}"/>
                    <Button Content="Eraser" ToolTip="Eraser (E)" Command="{Binding SelectEraserCommand}" 
                            Margin="2" Padding="8,4" 
                            Style="{StaticResource ToolButtonStyle}" 
                            IsChecked="{Binding CurrentTool.Type, Converter={StaticResource ToolTypeToEraserCheckedConverter}}"/>
                    <Button Content="Lasso" ToolTip="Lasso Tool (L)" Command="{Binding SelectLassoCommand}" 
                            Margin="2" Padding="8,4" 
                            Style="{StaticResource ToolButtonStyle}" 
                            IsChecked="{Binding CurrentTool.Type, Converter={StaticResource ToolTypeToLassoCheckedConverter}}"/>
                    <Button Content="Hand" ToolTip="Hand Tool" Command="{Binding SelectHandCommand}" 
                            Margin="2" Padding="8,4" 
                            Style="{StaticResource ToolButtonStyle}" 
                            IsChecked="{Binding CurrentTool.Type, Converter={StaticResource ToolTypeToHandCheckedConverter}}"/>
                </StackPanel>
                
                <!-- Colors -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button ToolTip="Black" Command="{Binding SetPenColorCommand}" CommandParameter="#FF000000"
                            Margin="2" Padding="8,4" Style="{StaticResource ColorButtonStyle}" Background="Black"/>
                    <Button ToolTip="Red" Command="{Binding SetPenColorCommand}" CommandParameter="#FFFF0000"
                            Margin="2" Padding="8,4" Style="{StaticResource ColorButtonStyle}" Background="Red"/>
                    <Button ToolTip="Blue" Command="{Binding SetPenColorCommand}" CommandParameter="#FF0000FF"
                            Margin="2" Padding="8,4" Style="{StaticResource ColorButtonStyle}" Background="Blue"/>
                    <Button ToolTip="Green" Command="{Binding SetPenColorCommand}" CommandParameter="#FF008000"
                            Margin="2" Padding="8,4" Style="{StaticResource ColorButtonStyle}" Background="Green"/>
                    <Button ToolTip="More Colors" Command="{Binding SetPenColorCommand}" CommandParameter="Custom"
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Content="..." Width="32"/>
                </StackPanel>
                
                <!-- Widths -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button ToolTip="Thin (1px)" Command="{Binding SetPenWidthCommand}" CommandParameter="1"
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Content="1px" Width="40"/>
                    <Button ToolTip="Medium (2px)" Command="{Binding SetPenWidthCommand}" CommandParameter="2"
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Content="2px" Width="40"/>
                    <Button ToolTip="Thick (4px)" Command="{Binding SetPenWidthCommand}" CommandParameter="4"
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Content="4px" Width="40"/>
                    <Button ToolTip="Very Thick (8px)" Command="{Binding SetPenWidthCommand}" CommandParameter="8"
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Content="8px" Width="40"/>
                </StackPanel>
                
                <!-- Page Navigation -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="&lt;" ToolTip="Previous Page" Command="{Binding PreviousPageCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="32"/>
                    <TextBlock Text="{Binding CurrentPageNumber}" VerticalAlignment="Center" Margin="5,0" FontSize="14"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                    <TextBlock Text="{Binding PageCount}" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                    <Button Content="&gt;" ToolTip="Next Page" Command="{Binding NextPageCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="32"/>
                    <Button Content="+" ToolTip="Add Page" Command="{Binding AddPageCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="32"/>
                    <Button Content="-" ToolTip="Remove Page" Command="{Binding RemovePageCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="32"/>
                </StackPanel>
                
                <!-- Zoom -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="-" ToolTip="Zoom Out" Command="{Binding ZoomOutCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="32"/>
                    <TextBlock Text="{Binding ZoomLevel, StringFormat='{0:P0}'}" VerticalAlignment="Center" Margin="5,0" FontSize="14"/>
                    <Button Content="+" ToolTip="Zoom In" Command="{Binding ZoomInCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="32"/>
                    <Button Content="100%" ToolTip="Reset Zoom" Command="{Binding ResetZoomCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="50"/>
                </StackPanel>
                
                <!-- Undo/Redo -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Undo" ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="60"/>
                    <Button Content="Redo" ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="60"/>
                </StackPanel>
                
                <!-- Edit Menu -->
                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <Button Content="Clear" ToolTip="Clear Page" Command="{Binding ClearPageCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="60"/>
                    <Button Content="Delete" ToolTip="Delete Selected" Command="{Binding DeleteSelectedCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="60"/>
                    <Button Content="Select All" ToolTip="Select All (Ctrl+A)" Command="{Binding SelectAllCommand}" 
                            Margin="2" Padding="8,4" Style="{StaticResource ToolButtonStyle}" Width="70"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding PageName}" Margin="10,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="GoodNotes Clone - v1.0" Margin="10,0"/>
            </StatusBarItem>
        </StatusBar>
        
        <!-- Main Content -->
        <Grid DockPanel.Dock="Fill">
            <!-- Sidebar - Notebooks and Pages -->
            <Border Width="200" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Notebooks List -->
                    <Expander Grid.Row="0" Header="Notebooks" IsExpanded="True" Margin="5">
                        <ListBox ItemsSource="{Binding Notebooks}" SelectedItem="{Binding CurrentNotebook}" 
                                 DisplayMemberPath="Name" Margin="5" BorderThickness="0"/>
                    </Expander>
                    
                    <!-- Pages List -->
                    <Expander Grid.Row="1" Header="Pages" IsExpanded="True" Margin="5">
                        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" 
                                 DisplayMemberPath="Name" Margin="5" BorderThickness="0" 
                                 SelectionMode="Single" SelectionChanged="PageList_SelectionChanged"/>
                    </Expander>
                    
                    <!-- Add Notebook Button -->
                    <Button Grid.Row="2" Content="+ New Notebook" Command="{Binding NewNotebookCommand}" 
                            Margin="5" HorizontalAlignment="Stretch" Padding="5"/>
                </Grid>
            </Border>
            
            <!-- Canvas Area -->
            <Grid Margin="0">
                <Border BorderBrush="#CCCCCC" BorderThickness="1">
                    <Canvas x:Name="DrawingCanvas" Background="White" 
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                            MouseMove="Canvas_MouseMove"
                            MouseRightButtonDown="Canvas_MouseRightButtonDown">
                        <Canvas.RenderTransform>
                            <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Canvas.RenderTransform>
                        <Canvas.Clip>
                            <RectangleGeometry x:Name="CanvasClip" Rect="0,0,800,1131"/>
                        </Canvas.Clip>
                    </Canvas>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
